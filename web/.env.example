# Copy to ".env.local" for `npm run dev`. Only VITE_* values reach the browser.
# Backend URL (local FastAPI or your Cloud Run URL). Leave unset to use http://<this host>:8000.
# Must be the Swerte3 API. If /health is 404, port 8000 is probably another app — use 8001.
VITE_API_URL=http://127.0.0.1:8001

# Optional GA4 measurement ID
VITE_GA_MEASUREMENT_ID=

# Optional single intro video URL (replaces the four bundled clips)
# VITE_VIDEO_HOME_URL=
